{
  "ask_user_question": {
    "additionalProperties": false,
    "properties": {
      "options": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "description": "brief tradeoff or explanation",
              "type": "string"
            },
            "label": {
              "description": "short option label",
              "type": "string"
            }
          },
          "required": [
            "label"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "question": {
        "description": "the question to ask the user",
        "type": "string"
      }
    },
    "required": [
      "question",
      "options"
    ],
    "type": "object"
  },
  "update_plan": {
    "additionalProperties": false,
    "properties": {
      "explanation": {
        "description": "optional short explanation for a plan change",
        "type": "string"
      },
      "steps": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "blocker": {
              "description": "required when status is blocked",
              "type": "string"
            },
            "status": {
              "enum": [
                "pending",
                "in_progress",
                "blocked",
                "completed"
              ],
              "type": "string"
            },
            "step": {
              "description": "short task description",
              "type": "string"
            }
          },
          "required": [
            "step",
            "status"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "steps"
    ],
    "type": "object"
  }
}
